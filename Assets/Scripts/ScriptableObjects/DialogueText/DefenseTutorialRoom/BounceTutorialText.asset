  dialogueNodes:
  - id: Start
    text: 'Great job, Now you have mastered the dash ability bound to the ranged
      weapon! '
    nextNodeIds:
    - 1
    choiceText: []
    choiceEventKeys: []
  - id: 1
    text: 'Unlike the ranged weapon, using melee weapon don''t allow you to dash. '
    nextNodeIds:
    - 2
    choiceText: []
    choiceEventKeys: []
  - id: 2
    text: 'But instead, press <sprite name="mr"> can let you bounce the bullets back
      to where it came. '
    nextNodeIds:
    - 3
    choiceText: []
    choiceEventKeys: []
  - id: 3
    text: Next, use <sprite name="2"> to change back to the sword. You can try several
      times in place.
    nextNodeIds:
    - 4
    choiceText: []
    choiceEventKeys: []
  - id: 4
    text: 'Once you are ready, this time I will release a armed enemy shooting at
      you constantly. '
    nextNodeIds:
    - 5
    choiceText: []
    choiceEventKeys: []
  - id: 5
    text: 'Try using <sprite name="mr"> to bounce bullets back instead of killing
      it directly. '
    nextNodeIds:
    - null
