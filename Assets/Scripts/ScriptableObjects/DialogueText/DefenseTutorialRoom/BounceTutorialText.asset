    text: Use <sprite name="2"> to change back to the sword and try it out!
    nextNodeIds:
    - 4
    choiceText: []
    choiceEventKeys: []
  - id: 4
    text: 'Once you are ready, I will release an armed enemy shooting at you constantly. '
